# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file.

APP_NAME=Recipe Book API
PORT=7000
NODE_ENV=development

# Long random string. Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# A DIFFERENT long random string. Generate one the same way as JWT_SECRET.
CSRF_SECRET=replace_with_a_separate_long_random_secret

# Where this API is reachable. Use your deployed Render URL in production.
BACKEND_URL=http://localhost:7000

# The exact browser origin of the frontend. Must match Vite (no trailing slash).
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string (Neon in production).
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
